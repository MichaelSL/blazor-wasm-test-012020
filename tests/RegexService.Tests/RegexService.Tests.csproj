<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- xunit.v3 4.x enables Microsoft.Testing.Platform v2 by default, which the VSTest-based
         `dotnet test` (still the SDK default) refuses to run. Keep this project on VSTest via
         xunit.runner.visualstudio; the xunit.v3 test app can still be run directly. -->
    <IsTestingPlatformApplication>false</IsTestingPlatformApplication>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../BlazorWasmRegex/Shared/BlazorWasmRegex.Shared.csproj" />
  </ItemGroup>

</Project>