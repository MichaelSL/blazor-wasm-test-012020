@* Static .NET regex quick reference shown under the tester. Clicking a token inserts it at the caret in
   the pattern (or, for substitutions, the replacement) field: js/app.js handles [data-insert]. *@
<section class="reference" aria-labelledby="refTitle">
    <div class="reference__head">
        <h2 class="reference__title" id="refTitle">.NET regex quick reference</h2>
        <p class="reference__hint">Click a token to insert it at the cursor; substitutions go into the replacement field.</p>
    </div>
    <div class="reference__grid">
        @foreach (var section in Sections)
        {
            <div class="ref-card">
                <h3 class="ref-card__title">@section.Title</h3>
                <ul class="ref-card__list">
                    @foreach (var item in section.Items)
                    {
                        <li>
                            <button type="button" class="ref-token" data-insert="@(item.Insert.Length > 0 ? item.Insert : item.Token)" data-target="@section.Target"
                                    aria-label="@($"Insert {item.Token}: {item.Meaning}")">
                                <span class="ref-token__code">@item.Token</span>
                                <span class="ref-token__desc">@item.Meaning</span>
                            </button>
                        </li>
                    }
                </ul>
            </div>
        }
    </div>
</section>

@code {
    private sealed record Item(string Token, string Meaning, string Insert = "");

    private sealed record Section(string Title, Item[] Items, string Target = "patternInput");

    private static readonly Section[] Sections =
    [
        new("Character classes",
        [
            new(".", "Any character except \\n (any character with Singleline)"),
            new("\\d", "Digit (any Unicode decimal digit unless ECMAScript)"),
            new("\\D", "Not a digit"),
            new("\\w", "Word character"),
            new("\\W", "Not a word character"),
            new("\\s", "Whitespace"),
            new("\\S", "Not whitespace"),
            new("[abc]", "Any of a, b, c"),
            new("[^abc]", "Anything except a, b, c"),
            new("[a-z]", "Character range"),
            new("[a-z-[aeiou]]", "Class subtraction: consonants only"),
            new("\\p{Lu}", "Unicode category or block, e.g. \\p{IsCyrillic}"),
        ]),
        new("Anchors",
        [
            new("^", "Start of input, or of each line with Multiline"),
            new("$", "End of input or line (also before a final \\n)"),
            new("\\A", "Start of input only"),
            new("\\z", "End of input only"),
            new("\\Z", "End of input or before a final \\n"),
            new("\\b", "Word boundary"),
            new("\\B", "Not a word boundary"),
            new("\\G", "Where the previous match ended"),
        ]),
        new("Quantifiers",
        [
            new("*", "0 or more"),
            new("+", "1 or more"),
            new("?", "0 or 1"),
            new("{3}", "Exactly 3"),
            new("{2,}", "2 or more"),
            new("{2,5}", "Between 2 and 5"),
            new("*?", "0 or more, lazy (as few as possible)"),
            new("+?", "1 or more, lazy"),
            new("??", "0 or 1, lazy"),
        ]),
        new("Groups and lookarounds",
        [
            new("(...)", "Numbered capturing group", "()"),
            new("(?<name>...)", "Named capturing group", "(?<name>)"),
            new("(?:...)", "Non-capturing group", "(?:)"),
            new("(?>...)", "Atomic group (no backtracking into it)", "(?>)"),
            new("(?=...)", "Positive lookahead", "(?=)"),
            new("(?!...)", "Negative lookahead", "(?!)"),
            new("(?<=...)", "Positive lookbehind", "(?<=)"),
            new("(?<!...)", "Negative lookbehind", "(?<!)"),
            new("\\1", "Backreference to group 1"),
            new("\\k<name>", "Backreference to a named group"),
            new("(?<open-close>...)", "Balancing group, for nested constructs", "(?<open-close>)"),
            new("a|b", "Alternation: a or b", "|"),
            new("(?(name)yes|no)", "Conditional: yes if the group matched"),
        ]),
        new("Inline options",
        [
            new("(?i)", "IgnoreCase from here on"),
            new("(?m)", "Multiline from here on"),
            new("(?s)", "Singleline from here on"),
            new("(?n)", "ExplicitCapture from here on"),
            new("(?x)", "IgnorePatternWhitespace from here on"),
            new("(?i:...)", "Option for this group only", "(?i:)"),
            new("(?-i)", "Turn an option off"),
        ]),
        new("Substitutions (Replace)",
        [
            new("$1", "Text of group 1"),
            new("${name}", "Text of a named group"),
            new("$0", "The whole match"),
            new("$&", "The whole match"),
