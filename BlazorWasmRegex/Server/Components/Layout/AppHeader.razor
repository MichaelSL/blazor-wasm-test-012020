@* Statically rendered: the theme toggle is handled by js/app.js ([data-theme-toggle]). *@
<header class="app-header">
    <div class="page app-header__inner">
        <a class="brand" href="" aria-label=".NET Regex Tester home">
            <span class="brand__mark" aria-hidden="true">.*</span>
            <span class="brand__name">.NET Regex Tester</span>
        </a>
        <nav class="app-nav" aria-label="Main">
            <NavLink class="app-nav__link" href="" Match="NavLinkMatch.All">Regex Tester</NavLink>
            <NavLink class="app-nav__link" href="about">About</NavLink>
            @* Pages are rendered once at image build time, so this can't be derived from the request URL. *@
            <a class="app-nav__link" href="https://monitor.dotnet-regex.com/" target="_blank" rel="noopener">
                HW Monitor<Icon Name="external" /><span class="visually-hidden">(opens in a new tab)</span>
            </a>
        </nav>
        <div class="app-header__meta">
            <a class="repo-link" href="@RepoUrl" target="_blank" rel="noopener"
               aria-label="@($"Source on GitHub, version {AppVersion} (opens in a new tab)")" title="@($"Source on GitHub · v {AppVersion}")">
                <svg class="repo-link__logo" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
                <span class="repo-link__version">v @AppVersion</span>
            </a>
            <button class="btn btn--ghost btn--icon theme-toggle" type="button" data-theme-toggle aria-label="Switch theme" aria-pressed="false">
                <Icon Name="moon" Size="18" Class="icon-moon" />
                <Icon Name="sun" Size="18" Class="icon-sun" />
            </button>
        </div>
    </div>
</header>

@code {
    public const string RepoUrl = "https://github.com/MichaelSL/blazor-wasm-test-012020";

    private static readonly string AppVersion = GetAppVersion();

    private static string GetAppVersion()
    {
        try
        {
            var informationalVersion = System.Reflection.CustomAttributeExtensions
                .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(typeof(AppHeader).Assembly)
                ?.InformationalVersion;
            return BlazorWasmRegex.Shared.Services.AppVersionFormatter.Format(informationalVersion);
        }
        catch
        {
            return string.Empty;
        }
    }
}
