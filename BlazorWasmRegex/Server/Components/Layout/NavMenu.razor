@* Statically rendered (no interactivity), so the mobile menu toggle is a CSS-only checkbox. *@
<div class="top-row pl-4 navbar navbar-dark">
    <a class="navbar-brand" href="">.NET Regex Tester</a>
    <label for="nav-toggle" class="navbar-toggler" title="Navigation menu">
        <span class="navbar-toggler-icon"></span>
    </label>
</div>

<input type="checkbox" id="nav-toggle" class="nav-toggle" aria-label="Navigation menu" />

<nav class="nav-menu" onclick="document.getElementById('nav-toggle').checked = false">
    <ul class="nav flex-column">
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-beaker" aria-hidden="true"></span> Regex Tester
            </NavLink>
        </li>
        <li class="nav-item px-3">
            <NavLink class="nav-link" href="about">
                <span class="oi oi-info" aria-hidden="true"></span> About
            </NavLink>
        </li>
        <li class="nav-item px-3">
            @* Pages are rendered once at image build time, so this can't be derived from the request URL. *@
            <a class="nav-link" href="https://monitor.dotnet-regex.com/">
                <span class="oi oi-dashboard" aria-hidden="true"></span> HW Monitor
            </a>
        </li>
        <li>&nbsp;</li>
        <li class="nav-item px-3">
            <a class="nav-link" target="_blank" rel="noopener" href="https://github.com/MichaelSL/blazor-wasm-test-012020">
                <span class="oi oi-fork" aria-hidden="true"></span>
                <span class="nav-version" title="v @AppVersion">v @AppVersion</span>
            </a>
        </li>
    </ul>
</nav>

@code {
    private static readonly string AppVersion = GetAppVersion();

    private static string GetAppVersion()
    {
        try
        {
            var informationalVersion = System.Reflection.CustomAttributeExtensions
                .GetCustomAttribute<System.Reflection.AssemblyInformationalVersionAttribute>(typeof(NavMenu).Assembly)
                ?.InformationalVersion;
            return BlazorWasmRegex.Shared.Services.AppVersionFormatter.Format(informationalVersion);
        }
        catch
        {
            return string.Empty;
        }
    }
}
