<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <!-- Interactive WebAssembly part of the Blazor Web App hosted by BlazorWasmRegex.Server.
       Only components rendered with InteractiveWebAssembly live here (RegexTester); pages and
       layout are static and live in the Server project. -->
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="11.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\BlazorWasmRegex.Shared.csproj" />
  </ItemGroup>

</Project>
