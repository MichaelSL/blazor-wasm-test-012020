@using BlazorWasmRegex.Shared.Models
@using BlazorWasmRegex.Shared.Services

@* Prerendered on the server with every control disabled (typing into the static copy would be lost when
   the interactive component replaces it). Scroll sync, gutter heights, copy buttons and hover linking
   live in js/app.js (regexTester.attach). *@
<div class="workbench" @ref="root" data-engine="@(IsReady ? "ready" : "loading")">

    @* ================= Left pane: inputs ================= *@
    <section class="pane editor-pane" aria-label="Pattern and test input">
        <fieldset class="editor-pane__fieldset" disabled="@(!IsReady)" @onkeydown="OnFormKeyDown">
            <legend class="visually-hidden">Regex tester input</legend>

            <div class="editor-pane__section">
                <div class="field">
                    <div class="field__head">
                        <label class="field__label" for="patternInput">Regular expression</label>
                        <div class="samples" role="group" aria-label="Load a sample">
                            <span class="samples__label">Samples</span>
                            <div class="segmented">
                                @foreach (var sample in SampleRegexLibrary.All)
                                {
                                    <button type="button" class="segmented__btn" aria-pressed="@(IsSampleActive(sample) ? "true" : "false")"
                                            @onclick="() => LoadSample(sample)">@sample.Label</button>
                                }
                            </div>
                        </div>
                    </div>
                    <div class="pattern-field @(State == RunState.Error ? "is-error" : null) @(State == RunState.Timeout ? "is-timeout" : null)">
                        <span class="pattern-field__delim pattern-field__delim--open" aria-hidden="true">/</span>
                        <div class="code-input">
                            <pre class="code-input__backdrop" aria-hidden="true"><span class="code-input__mirror">@foreach (var seg in PatternSegments)
                                {
                                    if (seg.CssClass is null)
                                    {
                                        @seg.Text
                                    }
                                    else
                                    {
                                        <span class="@seg.CssClass">@seg.Text</span>
                                    }
                                }</span></pre>
                            <input class="code-input__control" id="patternInput" type="text"
                                   @bind="Pattern" @bind:event="oninput" @bind:after="OnInputChanged"
                                   spellcheck="false" autocomplete="off" autocapitalize="off"
                                   placeholder="Enter a .NET pattern, e.g. (?<word>\w+)"
                                   aria-invalid="@(State == RunState.Error ? "true" : "false")" aria-describedby="patternMsg" />
                        </div>
                        <span class="pattern-field__delim" aria-hidden="true">/</span>
                        @{ var (letters, extras) = Flags(); }
                        <span class="pattern-field__flags" title="Active options" aria-label="@FlagsLabel(letters, extras)">
                            @if (letters.Length == 0 && extras.Length == 0)
                            {
                                <span class="flag-off">—</span>
                            }
                            else
                            {
                                @letters
                                @if (extras.Length > 0)
                                {
                                    @if (letters.Length > 0)
                                    {
                                        <span class="flag-off">·</span>
                                    }
                                    @extras
                                }
                            }
                        </span>
                    </div>
                    <div id="patternMsg" aria-live="polite">
                        @if (State == RunState.Error)
                        {
                            <p class="field-msg field-msg--error"><Icon Name="alert" Size="14" /><span>@PatternErrorText()</span></p>
                        }
                        else if (State == RunState.Timeout)
                        {
                            <p class="field-msg field-msg--timeout">
                                <Icon Name="clock" Size="14" />
                                <span>
                                    This pattern backtracks too much on some test lines. Avoid nested quantifiers such as <code>(a+)+</code>@(Options.NonBacktracking ? "." : ", or enable NonBacktracking under Advanced.")
                                </span>
                            </p>
                        }
                    </div>
                </div>
            </div>

            <div class="editor-pane__section">
                <div class="field">
                    <div class="field__head"><span class="field__label" id="optionsLabel">Options</span></div>
                    <div class="option-bar" role="group" aria-labelledby="optionsLabel">
                        @foreach (var o in RegexOptionInfo.All.Where(o => o.IsPrimary))
                        {
                            var reason = RegexOptionsService.GetDisabledReason(o.Id, Options);
                            <span class="option-chip">
                                <input class="option-chip__input" type="checkbox" id="opt-@o.Id" checked="@Options.IsSet(o.Id)"
                                       disabled="@(reason is not null)" aria-describedby="tip-@o.Id"
                                       @onchange="e => OnOptionChanged(o.Id, e)" />
                                <label class="option-chip__label" for="opt-@o.Id">
                                    <span class="option-chip__check"><Icon Name="check" /></span>@o.Label<span class="option-chip__flag">@o.Flag</span>
                                </label>
                                <OptionTooltip Option="o" Reason="@reason" />
                            </span>
                        }
                    </div>
                    <div class="advanced @(ShowAdvanced ? "is-open" : null)">
                        <button type="button" class="advanced__summary" aria-expanded="@(ShowAdvanced ? "true" : "false")" aria-controls="advancedGrid"
                                @onclick="() => ShowAdvanced = !ShowAdvanced">
                            <Icon Name="chevron-right" Class="advanced__chev" />
                            Advanced
                            <span class="count-badge @(AdvancedOnCount > 0 ? "is-active" : null)"
                                  aria-label="@($"{AdvancedOnCount} advanced option{(AdvancedOnCount == 1 ? "" : "s")} enabled")">@AdvancedOnCount</span>
                            <span class="advanced__summary-hint">7 more RegexOptions</span>
                        </button>
                        @if (ShowAdvanced)
                        {
                            <div class="advanced__grid" id="advancedGrid">
                                @foreach (var o in RegexOptionInfo.All.Where(o => !o.IsPrimary))
                                {
                                    var reason = RegexOptionsService.GetDisabledReason(o.Id, Options);
                                    <div class="adv-option @(reason is not null ? "is-disabled" : null)">
                                        <label class="adv-option__label" for="opt-@o.Id">
                                            <input class="adv-option__input" type="checkbox" id="opt-@o.Id" checked="@Options.IsSet(o.Id)"
                                                   disabled="@(reason is not null)" aria-describedby="tip-@o.Id"
                                                   @onchange="e => OnOptionChanged(o.Id, e)" />
                                            <span class="adv-option__text">
                                                <span class="adv-option__name">@o.Label@if (o.Tag is not null)
                                                    {
                                                        <span class="option-tag">@o.Tag</span>
                                                    }</span>
                                                @if (reason is not null)
                                                {
                                                    <span class="adv-option__reason">@reason</span>
                                                }
                                            </span>
                                            <span class="adv-option__flag">@o.Flag</span>
                                        </label>
                                        <OptionTooltip Option="o" Reason="@reason" />
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            </div>

            <div class="editor-pane__section">
                <div class="field">
                    <label class="field__label" for="replaceInput">Replacement <span class="field__hint field__hint--inline">(optional)</span></label>
                    <div class="text-input-wrap">
                        <input class="text-input" id="replaceInput" type="text"
                               @bind="Replacement" @bind:event="oninput" @bind:after="OnInputChanged"
                               spellcheck="false" autocomplete="off" autocapitalize="off"
                               placeholder="e.g. ${user} at ${domain}" aria-describedby="replaceHint" />
                    </div>
                    <p class="field__hint" id="replaceHint">Use <code>$1</code>, <code>$2</code> for numbered groups, <code>${name}</code> for named groups.</p>
                </div>
            </div>

            <div class="editor-pane__section">
                <div class="field">
                    <div class="field__head">
                        <label class="field__label" for="testInput">Test strings</label>
                        <span class="field__hint"><kbd>Ctrl</kbd> + <kbd>Enter</kbd> runs</span>
                    </div>
                    <p class="field__hint" id="testHint">One test per line; each line is matched on its own. The gutter shows the matches per line.</p>
                    @{ var editorLines = EditorLines(Tests); }
                    <div class="test-editor">
                        <div class="test-editor__gutter" aria-hidden="true">
                            <div class="test-editor__gutter-inner">
                                @for (var i = 0; i < editorLines.Count; i++)
                                {
                                    var line = ResultForLine(i, editorLines[i]);
                                    var status = line is null || line.IsEmpty ? null : line.Matches.Count > 0 ? "is-hit" : "is-miss";
                                    <div class="gutter-row @status">
                                        <span class="gutter-row__num">@(i + 1)</span>
                                        <span class="gutter-row__status">
                                            @if (status == "is-hit")
                                            {
                                                <Icon Name="check" Size="10" />@line!.Matches.Count
                                            }
                                            else if (status == "is-miss")
                                            {
                                                <text>–</text>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                        <div class="test-editor__body">
                            <div class="test-editor__backdrop" aria-hidden="true">
                                @for (var i = 0; i < editorLines.Count; i++)
                                {
                                    var line = ResultForLine(i, editorLines[i]);
                                    <div class="test-editor__line">@if (line is { Matches.Count: > 0 })
                                        {
                                            <HighlightedLine Line="line" Spans="Evaluator.HighlightLine(line.Text, line.Matches)" />
                                        }
                                        else
                                        {
                                            @editorLines[i]
                                        }</div>
                                }
                            </div>
                            <textarea class="test-editor__input" id="testInput" wrap="soft"
                                      @bind="Tests" @bind:event="oninput" @bind:after="OnInputChanged"
                                      spellcheck="false" autocomplete="off" autocapitalize="off"
                                      aria-describedby="testHint" placeholder="Paste or type test strings, one per line"></textarea>
                        </div>
                    </div>
                </div>
            </div>

            <div class="editor-pane__section editor-pane__section--actions">
                <div class="action-bar">
                    <button class="btn btn--primary" type="button" @onclick="TestClick">
                        <Icon Name="play" />Test<span class="btn__kbd" aria-hidden="true">Ctrl+↵</span>
                    </button>
                    <label class="switch" title="Re-run automatically while you type">
                        <input class="switch__input" type="checkbox" checked="@Live" @onchange="OnLiveChanged" />
                        <span class="switch__track" aria-hidden="true"></span>
                        Live
                    </label>
                    <span class="action-bar__spacer"></span>
                    <button class="btn" type="button" @onclick="ReplaceClick" disabled="@string.IsNullOrEmpty(Replacement)"
                            title="@(string.IsNullOrEmpty(Replacement) ? "Enter a replacement pattern to enable" : "Show Regex.Replace results")">
                        <Icon Name="replace" />Replace
                    </button>
                    <div class="menu" @onkeydown="OnExportKeyDown">
                        <button class="btn" type="button" aria-haspopup="menu" aria-expanded="@(ExportOpen ? "true" : "false")" aria-controls="exportList"
                                disabled="@(!CanExport)" title="@(CanExport ? "Export matches" : "No matches to export")" @onclick="ToggleExport">
                            <Icon Name="download" />Export<Icon Name="chevron-down" />
                        </button>
                        @if (ExportOpen)
                        {
                            <div class="menu__backdrop" @onclick="() => ExportOpen = false"></div>
                            <ul class="menu__list" id="exportList" role="menu">
                                <li role="none">
                                    <button class="menu__item" role="menuitem" type="button" @onclick='() => Export("json")'>
                                        <Icon Name="brackets" /><span class="menu__item-text"><span class="menu__item-title">JSON</span><span class="menu__item-sub">Matches with groups and positions</span></span>
                                    </button>
                                </li>
                                <li role="none">
                                    <button class="menu__item" role="menuitem" type="button" @onclick='() => Export("csv")'>
                                        <Icon Name="table" /><span class="menu__item-text"><span class="menu__item-title">CSV</span><span class="menu__item-sub">One row per match</span></span>
                                    </button>
                                </li>
                                <li role="none">
                                    <button class="menu__item" role="menuitem" type="button" @onclick='() => Export("txt")'>
                                        <Icon Name="file" /><span class="menu__item-text"><span class="menu__item-title">Text</span><span class="menu__item-sub">Readable summary of the matches</span></span>
                                    </button>
                                </li>
                            </ul>
                        }
                    </div>
                </div>
            </div>
        </fieldset>
    </section>

    @* ================= Right pane: results ================= *@
    <section class="pane results-pane" aria-label="Results">
        <StatusBar Kind="@StatusKind" Main="@StatusMain" Sub="@StatusSub" />
        <div class="result-tabs" role="tablist" aria-label="Result views" @onkeydown="OnTabKeyDown">
            @foreach (var tab in Tabs)
            {
                var selected = tab.Key == ActiveTab;
                <button class="result-tab" role="tab" type="button" id="tab-@tab.Key" aria-controls="panel-@tab.Key"
                        aria-selected="@(selected ? "true" : "false")" tabindex="@(selected ? 0 : -1)"
                        @ref="tabRefs[tab.Key]" @onclick="() => SelectTab(tab.Key)">
                    @tab.Label <span class="count-badge">@tab.Count</span>
                </button>
            }
        </div>
        <div class="result-panels">
            @if (!IsReady)
            {
                <div class="skeleton" aria-hidden="true">
                    <div class="skeleton__row"></div><div class="skeleton__row"></div><div class="skeleton__row"></div><div class="skeleton__row"></div><div class="skeleton__row"></div>
                </div>
            }
            else
            {
                <div class="result-panel" role="tabpanel" id="panel-@ActiveTab" aria-labelledby="tab-@ActiveTab" tabindex="0">
                    @if (ActiveTab == "replace" && string.IsNullOrEmpty(Replacement))
                    {
                        <EmptyState IconName="replace" Title="No replacement pattern" Code="${user} at ${domain}   ·   $1   ·   $$ for a literal $">
                            Enter a replacement on the left to preview Regex.Replace for every test line.
                        </EmptyState>
                    }
                    else if (State == RunState.Empty)
                    {
                        <EmptyState IconName="pen" Title="No pattern yet">Type a regular expression on the left or pick a sample. Results update as you type.</EmptyState>
                    }
                    else if (State == RunState.Error)
                    {
                        <EmptyState IconName="alert" Title="Fix the pattern to see results">@ErrorMessage. @(ParseError is null ? "" : "The problem is underlined in red in the pattern field.")</EmptyState>
                    }
                    else if (State == RunState.Timeout)
                    {
                        <EmptyState IconName="clock" Title="Matching was stopped">The engine gave up after 2 seconds. Simplify nested quantifiers or try the NonBacktracking option.</EmptyState>
                    }
                    else if (Result.NonEmptyLines == 0)
                    {
                        <EmptyState IconName="list" Title="No test strings">Add one test string per line in the editor on the left. Each line is matched on its own.</EmptyState>
                    }
                    else
                    {
                        switch (ActiveTab)
                        {
                            case "split": <SplitView Result="Result" /> break;
                            case "table": <TableView Result="Result" Evaluator="Evaluator" /> break;
                            case "groups": <GroupsView Result="Result" GroupCount="GroupCount" /> break;
                            case "replace": <ReplaceView Result="Result" /> break;
                            default: <MatchesView Result="Result" Evaluator="Evaluator" /> break;
                        }
                    }
                </div>
            }
        </div>
    </section>
</div>

@code {
    private static string FlagsLabel(string letters, string extras)
    {
        var all = (letters + " " + extras).Trim();
        return "Active options: " + (all.Length == 0 ? "none" : all);
    }

    private string StatusKind => !IsReady ? "loading"
        : Flash is not null ? "success"
        : State switch
        {
            RunState.Empty => "empty",
            RunState.Error => "error",
            RunState.Timeout => "timeout",
            _ => Result.TotalMatches > 0 ? "ok" : "nomatch",
        };

    private string StatusMain => !IsReady ? "Loading the .NET regex engine…"
        : Flash is { } flash ? flash.Main
        : State switch
        {
            RunState.Empty => "Enter a pattern to start",
            RunState.Error => $"Invalid pattern: {ErrorMessage}",
            RunState.Timeout => "Expression timed out: possible catastrophic backtracking",
            _ when Result.TotalMatches == 0 => "No matches",
            _ => $"{Fmt.Plural(Result.TotalMatches, "match", "matches")} in {Result.ElapsedMilliseconds} ms",
        };

    private string StatusSub => !IsReady ? "Downloading the WebAssembly runtime. The controls unlock when it's ready."
        : Flash is { } flash ? flash.Sub
        : State switch
        {
            RunState.Empty => "Matches appear here as you type.",
            RunState.Error => ParseError is null ? "" : $"At offset {ParseError.Offset} of the pattern.",
            RunState.Timeout => "Stopped after the 2 s match timeout. No results are shown.",
            _ => $"{Result.MatchedLines} of {Fmt.Plural(Result.NonEmptyLines, "line", "lines")} matched · {Fmt.Plural(GroupCount, "capture group", "capture groups")}",
        };
}
