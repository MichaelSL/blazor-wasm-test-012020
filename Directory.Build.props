<Project>
	<PropertyGroup>
		<Product>Blazor Regex Tester</Product>
		<Company>Michael Samorokov</Company>
		<!-- Local default. CI passes -p:Version=yyyy.M.d.<run number> and -p:SourceRevisionId=<short sha>
		     through the Dockerfile build args; FileVersion and InformationalVersion derive from these. -->
		<Version>0.0.0.1</Version>
	</PropertyGroup>
</Project>
